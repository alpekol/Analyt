{
  "name": "seo-analyzer-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "SEO Analyzer Backend API",
  "author": "SEO Analyzer Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext ts",
    "lint:fix": "eslint . --ext ts --fix",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "prisma": "^5.4.1",
    "@prisma/client": "^5.4.1",
    "redis": "^4.6.10",
    "winston": "^3.11.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.22.4",
    "dotenv": "^16.3.1",
    "express-rate-limit": "^7.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.0",
    "@types/cors": "^2.8.15",
    "@types/cheerio": "^0.22.30",
    "@types/bcryptjs": "^2.4.4",
    "@types/jsonwebtoken": "^9.0.4",
    "typescript": "^5.2.2",
    "tsx": "^3.14.0",
    "eslint": "^8.50.0",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "prettier": "^3.0.3",
    "vitest": "^0.34.6"
  }
}
